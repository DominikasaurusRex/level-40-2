{
  "name": "level-40",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance:field": "vitest run src/balance/__tests__/field-balance.spec.ts --reporter=verbose --mode balance",
    "balance:forest": "vitest run src/balance/__tests__/forest-balance.spec.ts --reporter=verbose --mode balance",
    "balance:cave": "vitest run src/balance/__tests__/cave-balance.spec.ts --reporter=verbose --mode balance",
    "balance:wasteland": "vitest run src/balance/__tests__/wasteland-balance.spec.ts --reporter=verbose --mode balance",
    "balance:ruins": "vitest run src/balance/__tests__/ruins-balance.spec.ts --reporter=verbose --mode balance",
    "balance:dungeon": "vitest run src/balance/__tests__/dungeon-balance.spec.ts --reporter=verbose --mode balance",
    "balance:hell": "vitest run src/balance/__tests__/hell-balance.spec.ts --reporter=verbose --mode balance",
    "balance:abyss": "vitest run src/balance/__tests__/abyss-balance.spec.ts --reporter=verbose --mode balance"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
